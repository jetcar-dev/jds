{
    "name": "jetcar/jds-docs-blade",
    "description": "Laravel renderer for JDS documentation examples",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../../../packages/blade",
            "options": {"symlink": true, "versions": {"jetcar/jds-blade": "dev-main"}}
        }
    ],
    "require": {
        "php": "^8.3",
        "jetcar/jds-blade": "dev-main",
        "laravel/framework": "^13.0"
    },
    "config": {
        "sort-packages": true
    }
}
