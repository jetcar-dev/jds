{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@jetcar/docs",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently --kill-others --names docs,blade --prefix-colors cyan,magenta \"next dev --port 3000\" \"php blade/artisan serve --port=8001\"",
        "build": "next build",
        "start": "next start --port 3000",
        "typecheck": "tsc --noEmit",
        "test": "npm run typecheck"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "fumadocs-core": "^16.14.5",
        "fumadocs-mdx": "^15.3.0",
        "fumadocs-ui": "npm:@fumadocs/base-ui@^16.14.5",
        "next": "^16.3.1",
        "next-themes": "^0.4.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "unist-util-visit": "^5.1.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/mdx": "^2.0.13",
        "@types/node": "^24.0.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "concurrently": "^10.0.4",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3"
    }
}
