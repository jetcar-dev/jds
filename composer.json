{
    "name": "jetcar/jds",
    "description": "JetCar Design System Blade components",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Jetcar\\Jds\\": "package/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jetcar\\Jds\\JdsServiceProvider"
            ]
        }
    },
    "archive": {
        "exclude": [
            "/docs",
            "/deploy",
            "/.github",
            "/Dockerfile",
            "/.dockerignore"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
